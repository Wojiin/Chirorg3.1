COMPOSE_PROJECT_NAME=chirorg31-prod
MYSQL_DATABASE=chirorg
MYSQL_USER=chirorg
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
APP_SECRET=change-me-with-a-long-random-value
DATABASE_URL=mysql://chirorg:change-me@database:3306/chirorg?serverVersion=8.4.0&charset=utf8mb4
DEFAULT_URI=https://api.example.org
CORS_ALLOW_ORIGIN=^https://app\.example\.org$
JWT_PASSPHRASE=change-me
JWT_PRIVATE_KEY_PATH=./backend/config/jwt/private.pem
JWT_PUBLIC_KEY_PATH=./backend/config/jwt/public.pem
BACKEND_HTTP_PORT=8080
