COMPOSE_PROJECT_NAME=chirorg31-prod
APP_DOMAIN=chirorg.example.org
APP_HOST=chirorg.example.org
ACME_EMAIL=administrateur@example.org
HTTP_PORT=80
HTTPS_PORT=443

IMAGE_TAG=sha-a-remplacer
BACKEND_IMAGE=ghcr.io/wojiin/chirorg3.1-backend
BACKEND_NGINX_IMAGE=ghcr.io/wojiin/chirorg3.1-backend-nginx
FRONTEND_IMAGE=ghcr.io/wojiin/chirorg3.1-frontend

MYSQL_DATABASE=chirorg
MYSQL_USER=chirorg
MYSQL_PASSWORD=a-remplacer
MYSQL_ROOT_PASSWORD=a-remplacer
APP_SECRET=a-remplacer-par-une-longue-valeur-aleatoire
DATABASE_URL=mysql://chirorg:a-remplacer@database:3306/chirorg?serverVersion=8.4.0&charset=utf8mb4
DEFAULT_URI=https://chirorg.example.org
CORS_ALLOW_ORIGIN=^https://chirorg\.example\.org$
TRUSTED_PROXIES=private_ranges
TRUSTED_HOSTS=^chirorg\.example\.org$

JWT_PASSPHRASE=a-remplacer
JWT_PRIVATE_KEY_PATH=./secrets/jwt/private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt/public.pem
PROGRAMME_CLEANUP_HOUR=6
BACKUP_RETENTION_DAYS=14
# Facultatif : cible rclone hors serveur, par exemple ovh-swift:chirorg
BACKUP_RCLONE_REMOTE=
